# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but .env.test holds only fake emulator values and IS committed (see it +
# tests/e2e/README.md). Keep this exception below the broad ignore above.
!.env.test
# ...and .env.example is the setup template CLAUDE.md points readers at, so it has
# to exist in a fresh clone. The broad `.env*` above had been swallowing it, which
# made that link resolve to nothing (found 2026-08-06).
#
# ⚠️ It must stay SECRET-FREE. Every populated value is either NEXT_PUBLIC_* (already
# in the client bundle) or an OAuth CLIENT ID (the public half); SERVICE_ACCOUNT_KEY,
# YOUTUBE_CLIENT_SECRET, SMTP_PASSWORD and the Kakao secret are left EMPTY on purpose,
# and addresses are placeholders. Git history is hard to scrub — check before adding
# a line, not after.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cache
**/*.cache
.vscode/*
.history/
.firebase/

# playwright / e2e
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
# saved storageState (per-role auth) — regenerated by global.setup.ts each run
/tests/e2e/.auth/

# firebase emulator debug logs
firebase-debug.log
firestore-debug.log
storage-debug.log
ui-debug.log
database-debug.log
pubsub-debug.log

# secrets & configs
config/firebase/mountaincats-61543-7329e795c352.json
google_svs_account.json

# media — fetched at build time by scripts/maintenance/fetch-static-assets.js
# (single strategy: the build is the source of truth for these, not git).
# About photos are no longer among them (2026-08-02) — they serve live from
# Storage, keyed on the filename in the CMS record.
public/images/thumbnails/*

# e2e album fixtures — public/-served (spike S3), copied from
# tests/e2e/fixtures/images/test-fixtures/ by scripts/test/seed-emulators.mjs.
public/images/test-fixtures/

# Terraform — never commit real secrets or local state.
# (Dir is parked/stale under _infra/_terraform; patterns kept current in case it's reactivated.)
_infra/_terraform/.terraform/
_infra/_terraform/terraform.tfvars
_infra/_terraform/terraform.tfstate
_infra/_terraform/terraform.tfstate.backup
_infra/_terraform/.terraform.lock.hcl


# Firestore offline exports — contain OAuth tokens + PII, never commit
/backups/

# code-graph tooling evaluation (docs/planning/pending/code-graph-tooling-evaluation-20260728.md)
# Generated indexes/graphs + the per-tool scoping configs. All reproducible; none belong in git.
/graphify-out/
/.codegraph/
/codegraph-out/
/.ua/
/codegraph.json
/.graphifyignore

# Work registry — transient checkout file (work_tracking/SCHEMA.md §3).
# Committing it once already cost us the file: a branch merge filled it with conflict
# markers and destroyed the very file the recovery procedure depends on.
/work_tracking/work.json

# The browsable SQLite view of the work registry. GENERATED by work_tracking/scripts/build.js
# on every build, and rebuilt from registry.ndjson, which stays the only source of truth. A
# binary committed beside the log would give up line diffs, PR review and real merge conflicts —
# the three things the NDJSON storage decision was made to keep (restructure §4, amended
# 2026-08-09). Regenerate it with: node work_tracking/scripts/build.js
work_tracking/registry.db
