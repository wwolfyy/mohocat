# E2E test environment — committed on purpose: contains ONLY fake values.
#
# Consumed by the emulator-backed Playwright suite (see tests/e2e/README.md).
# The `demo-` project id is special-cased by the Firebase SDKs/emulators so they
# can NEVER reach a real project even if an emulator-host var is missing. None of
# these values are ever set in the Vercel dashboard, so production is unaffected.

# Flips the client SDK (src/services/firebase.ts) to connect*Emulator + skip
# Analytics, and the Admin SDK / asset script to credential-less emulator init.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Fake Firebase client config (baked into the build; must be present before
# `next build`). apiKey/appId are placeholders the emulator ignores.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-mohocat.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-mohocat
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-mohocat.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Mountain selection (unchanged from prod default).
MOUNTAIN_ID=geyang

# Asset-fetch script project-id override (WP4): the script otherwise hardcodes
# the production project id, which under the demo project would read an empty
# namespace and produce a thumbnail-less (failing) build.
FIREBASE_PROJECT_ID_OVERRIDE=demo-mohocat

# SMTP — deliberately BLANK, and blank is load-bearing.
#
# 🔴 Without these keys the harness SENDS REAL EMAIL. `next start` runs Next's own
# env loader, which backfills any key not already in process.env from `.env` on
# disk — so the developer's real Gmail credentials reached /api/contact and every
# full e2e run delivered two live 동참 notifications to the production adminEmail.
# (Found 2026-08-06, once the contact page began rendering `emailDelivered`; the
# credentials had simply been failing before, which hid it.)
#
# Declaring them EMPTY here is what stops that: `dotenv -e .env.test` puts the keys
# in process.env, and Next only fills keys that are `undefined` — an empty string
# is defined, so `.env` can no longer win. The route's own guard then reports
# "SMTP not configured", records the contact, and returns emailDelivered:false.
#
# ⚠️ Do NOT give these real values to "test the email path". The suite is hermetic
# by design (it does not touch the public internet); use `npm run smtp:verify`.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
