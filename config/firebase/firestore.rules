rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public collections - no auth required.
    // points stays write-locked: there is no live admin write path (the 급식소/겨울집
    // admin pages are disabled placeholders; PointService.create/update/deletePoint
    // are defined but never called). Open this only when a points editor is built.
    match /points/{x} {
      allow read: if true;
      allow write: if false;
    }

    match /cats/{x} {
      allow read: if true;
      // The admin Cat CMS (src/app/admin/cats/page.tsx) writes via the client
      // SDK, so gate writes on the cat-management permission — mirroring the
      // posts_feeding / posts_butler rules. (Future consideration: move admin
      // writes behind Admin SDK routes and restore `write: if false` — see
      // docs/handoff/2026-06-28-handoff-10.md.)
      allow write: if request.auth != null && hasPermission(request.auth.uid, 'manage-cat');
    }

    // The admin CMS writes these collections via the client SDK, so gate writes
    // on the relevant management permission — mirroring the cats / posts_* rules.
    // (Future consideration: move admin writes behind Admin SDK routes and restore
    // `write: if false` — see docs/handoff/2026-06-28-handoff-11.md §4.)

    // About-page editor (src/components/admin/AboutContentEditor.tsx) → 앱관리.
    match /about_content/{x} {
      allow read: if true;
      allow write: if request.auth != null && hasPermission(request.auth.uid, 'manage-app');
    }

    // Photo album tagging (src/app/admin/tag-images/page.tsx, NewPostForm, …).
    match /cat_images/{x} {
      allow read: if true;
      allow write: if request.auth != null && hasPermission(request.auth.uid, 'manage-photo');
    }

    // Video album tagging (src/app/admin/tag-videos/page.tsx). Server-side YouTube
    // sync/upload uses the Admin SDK and bypasses these rules.
    match /cat_videos/{x} {
      allow read: if true;
      allow write: if request.auth != null && hasPermission(request.auth.uid, 'manage-video');
    }

    // Announcements admin (src/app/admin/posts/page.tsx via announcement-service).
    match /posts_announcements/{x} {
      allow read: if true;
      allow write: if request.auth != null && hasPermission(request.auth.uid, 'manage-posts');
    }

    // 동참(contact) submissions — members-only create, admin-only read.
    // create: never from the client. Submissions go through POST /api/contact, which
    //   verifies the submitter's ID token and writes via the Admin SDK (bypasses rules).
    // read: admins with 'manage-users' (the Contact Management admin view).
    // update/delete: never from the client.
    match /contacts/{document} {
      allow create: if false;
      allow read: if request.auth != null &&
        hasPermission(request.auth.uid, 'manage-users');
      allow update, delete: if false;
    }

    // Permission-managed collections

    // Feeding-spot status (급식소 현황) read by FeedingSpotsList on the butler-stream
    // page and written by the client SDK when a butler logs a feeding post
    // (feeding-spots-service.updateFeedingSpots, via NewPostForm) — so gate writes on
    // 'manage-posts', mirroring posts_feeding. The server-side admin path uses the
    // Admin SDK (feeding-spots-admin-service) and bypasses these rules.
    match /feeding_spots/{document} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        hasPermission(request.auth.uid, 'manage-posts');
    }

    match /posts_feeding/{document} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        hasPermission(request.auth.uid, 'manage-posts');
    }

    match /posts_butler/{document} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        hasPermission(request.auth.uid, 'manage-posts');
    }

    // Permission system collections
    // NOTE: the app migrated this collection from `user_permissions` to `users`
    // (see PermissionService.usersCollection). The rule and the hasPermission()
    // helper below must reference `users` to match the live data.
    match /users/{userId} {
      // Users can read their own doc; admins (manage-users) can read any user doc.
      // The latter is required by the client-SDK role-assignment path
      // (RoleAssignmentService.assignSpecificRole reads the target user's doc before
      // writing the new role).
      allow read: if request.auth != null &&
        (request.auth.uid == userId || hasPermission(request.auth.uid, 'manage-users'));

      // Role/permission writes currently go through the client SDK (the admin
      // members page → RoleAssignmentService). Gate on `manage-users` (admin-only)
      // so this stays a server-enforced boundary — mirroring the cats rule.
      // Future consideration: move these writes behind an Admin SDK API route and
      // restore `write: if false` (see PROJECT_PLAN §7 / handoff-10).
      allow write: if request.auth != null && hasPermission(request.auth.uid, 'manage-users');
    }

    // Role→permission matrix — the single source of truth for role permissions:
    // both hasPermission() (below) and requireApiPermission (server API gate) read
    // this doc live. Allow authed clients to read it too, so the client UI resolves
    // permissions from the LIVE matrix instead of the stale bundled JSON fallback
    // (permission-service.loadConfig). Not sensitive — role→permission config, no
    // PII/secrets. Writes stay Admin-SDK-only (POST /api/admin/role-permissions,
    // manage-users) → never from the client.
    // (resource-config in this same collection is intentionally NOT matched here: it
    // is read/written only via /api/admin/resource-permissions, so it stays on the
    // default-deny below.)
    match /role_permissions/role-config {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /permission_logs/{logId} {
      // Read access for admins
      allow read: if request.auth != null && 
        hasPermission(request.auth.uid, 'view-analytics');
      
      // Write access only via cloud functions
      allow write: if false;
    }

    // Admin-only collections
    match /admin_data/{document} {
      allow read, write: if request.auth != null && 
        hasPermission(request.auth.uid, 'manage-users');
    }

    match /analytics/{document} {
      allow read: if request.auth != null && 
        hasPermission(request.auth.uid, 'view-analytics');
      allow write: if request.auth != null && 
        hasPermission(request.auth.uid, 'manage-settings');
    }

    // Helper: does the user have `permission`?
    // Resolves the user's role -> permissions from the single source of truth
    // `role_permissions/role-config` (the same doc the admin Permission Matrix edits),
    // instead of a per-user `currentRole.permissions` snapshot — that array is left
    // empty by design; permissions are derived from the role, not stored per user.
    //
    // MUST live INSIDE this match block: a top-level function cannot see the match's
    // `database` variable, so `$(database)` resolves empty and every hasPermission-
    // gated rule silently denies (this was the bug). See
    // docs/codebase/permissions-and-roles.md.
    function hasPermission(userId, permission) {
      let user = /databases/$(database)/documents/users/$(userId);
      let config = /databases/$(database)/documents/role_permissions/role-config;
      return exists(user) && exists(config) &&
             get(user).data.currentRole.isActive == true &&
             get(user).data.currentRole.role in get(config).data.roles &&
             permission in get(config).data.roles[get(user).data.currentRole.role].permissions;
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
