   "name": "cache-config.ts",
   "filePath": "src/lib/cache-config.ts",
   "summary": "Single source of truth for the ISR fallback revalidate window (1 hour), re-exported as `revalidate` by the baked public route segments as a time-based backstop behind on-demand revalidation.",
   "tags": [
    "configuration",
    "isr",
    "caching",
    "constants"
   ],
   "complexity": "simple",
   "languageNotes": "Hardcoded rather than env-driven because Next.js requires a segment's `revalidate` export to be statically analyzable."
  },
  {
   "id": "file:src/lib/revalidate-client.ts",
   "type": "file",
   "name": "revalidate-client.ts",
   "filePath": "src/lib/revalidate-client.ts",
   "summary": "Client helper that fires a best-effort on-demand revalidation of the baked public pages after an admin mutation, attaching the caller's Firebase ID token to the members-only revalidate API route.",
