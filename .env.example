# NEXT_PUBLIC_KAKAO_CLIENT_SECRET=
NEXT_PUBLIC_KAKAO_OAUTH_ENABLED=true

# Application Configuration
NEXT_PUBLIC_BASE_URL=http://localhost:3000 # will be overriden by Vercel
SERVICE_ACCOUNT_KEY=

# SMTP Configuration (for notifying contact form submissions)
#
# SMTP_FROM must EQUAL SMTP_USER. Gmail silently rewrites a From address the
# authenticated account does not own, so a mismatch is not an error — it is a
# no-op that still reports success.
#
# SMTP_PASSWORD is a 16-character Gmail App Password (spaces removed), never the
# account password. Setup steps + caveats: docs/manuals/deployment/README.md.
#
# Check a credential with `npm run smtp:verify` before putting it in Vercel — it
# authenticates without sending mail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<gmail address>
SMTP_PASSWORD=
SMTP_FROM=<same gmail address as SMTP_USER>


