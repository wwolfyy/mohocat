# Youtube config
NEXT_PUBLIC_YOUTUBE_API_KEY= # app loads this for here for from mountains.json
YOUTUBE_CLIENT_ID=266233773870-f3ih7cj734e18aoc3gc4tmt3unfgko9k.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth/callback # will be overriden by Vercel
