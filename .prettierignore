# Ignore generated and cache files
.next/
out/
build/
node_modules/

# The work registry's human view is GENERATED by work_tracking/scripts/build.js, and CI
# checks that it still equals build(registry.ndjson). Prettier re-aligns markdown table
# columns, which breaks that check on every commit — the pre-commit hook did exactly that
# the first time it ran. Formatting is build.js's job, not prettier's.
work_tracking/registry.md

# Record prose is lifted VERBATIM from the migrated source files, and source_ref pins each
# one to the commit it came from. Reflowing it would mean the stored text no longer matches
# what `git show <pin>` returns, which is the whole audit trail for a 315-row bulk import.
work_tracking/records/

# Ignore media and data
public/images/
*.json
package-lock.json

# Ignore config files that might conflict
_infra/_terraform/
.husky/
